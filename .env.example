APP_ENV=local
DATABASE_URL=postgresql+psycopg://localone:localone@localhost:5433/localone_test
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 로그아웃한 세션 거부(AUTH-2). production은 true 필수. 로컬 docker DB에는 auth 스키마가 없어 false
AUTH_SESSION_CHECK=false
POST_IMAGE_BUCKET=post-images

# 공공 조회 제공자 키. 없으면 명시적으로 넣은 시드·캐시를 사용한다.
DATA4LIBRARY_API_KEY=
DATA4LIBRARY_API_BASE_URL=http://data4library.kr/api
# 카카오 책 검색: 카카오 개발자 콘솔 앱 키의 REST API 키(지도용 JavaScript 키 아님)
KAKAO_REST_API_KEY=
KAKAO_API_BASE_URL=https://dapi.kakao.com/v3/search
