EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
# Apple 로그인(iOS만). 유료 Apple Developer 계정이 생기면 true로 바꾼다. 비우거나 다른 값이면 꺼짐(버튼 없음·권한 없음)
EXPO_PUBLIC_APPLE_SIGNIN_ENABLED=false
# 카카오맵 JavaScript 키(공개 키). 카카오 개발자 콘솔 웹 도메인에 http://localhost:8081 과 https://map.localone.invalid 등록
EXPO_PUBLIC_KAKAO_JS_KEY=
