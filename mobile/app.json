{
  "expo": {
    "name": "동네한권",
    "slug": "localone",
    "version": "0.0.1",
    "scheme": "localone",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "ios": {
      "bundleIdentifier": "kr.localone.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "kr.localone.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
